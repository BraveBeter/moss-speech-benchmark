{
  "device": "cpu",
  "asr_en": {
    "backend": "qwen3-asr",
    "base_url": "http://127.0.0.1:8001",
    "model": "Qwen/Qwen3-ASR-1.7B",
    "concurrency": 32,
    "path": "/path/to/local/qwen3-asr",
    "revision": "REPLACE_WITH_MODEL_COMMIT"
